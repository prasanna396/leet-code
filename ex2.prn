#include <stdio.h>
#include <unistd.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
   int fd[2];
   pid_t pid;
   // Fix 1: Use char array (or char*) for strings, not a single char
   char write_msg[] = "Hello From Parent"; 
   char read_msg[100];
   // Fix 2: Declare bytes_read outside the if block so it is accessible later
   int bytes_read = 0; 

   if (pipe(fd) == -1) {
      perror("pipe creation failed");
      return 1;
   }

   pid = fork();
   if (pid < 0) {
      perror("Fork failed");
      return 1;
   }

   if (pid == 0) {
      // Child process reads from the pipe
      close(fd[1]); // Close unused write end
      bytes_read = read(fd[0], read_msg, sizeof(read_msg) - 1);
      
      if (bytes_read > 0) {
         // Fix 3: Use the proper null-terminator character '\0'
         read_msg[bytes_read] = '\0'; 
         printf("child received: %s\n", read_msg);
      }
      close(fd[0]); // Fix 4: Corrected syntax close(fd[0])
   } 
   else {
      // Parent process writes to the pipe
      close(fd[0]); // Close unused read end
      printf("parent sending: %s\n", write_msg);
      // Fix 5: Pass the required buffer and size to the write function
      write(fd[1], write_msg, strlen(write_msg));
      close(fd[1]);
      wait(NULL); // Wait for child to finish
   }

   return 0;
}

