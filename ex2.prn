#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int findgcd(int a, int b) {
   while (b != 0) {
      int temp = b;
      b = a % b; // Fix 1: Properly using 'b' ensures no modulo-by-zero crash
      a = temp;
   }
   return a;
}

int main() {
   int fd[2];
   int lcm;
   
   if (pipe(fd) == -1) {
      perror("Pipe failed");
      return 1;
   }
   
   if (fork() == 0) {
      close(fd[0]); // Close unused read end
      
      int child_arr[2]; // Fix 2: Explicit array allocation
      printf("Enter two numbers: ");
      for (int i = 0; i < 2; i++) {
         if (scanf("%d", &child_arr[i]) != 1) {
            return 1; 
         }
      }
      
      write(fd[1], child_arr, 2 * sizeof(int));
      close(fd[1]); // Close write end after sending
   }
   else {
      close(fd[1]); // Close unused write end
      
      int parent_arr[2]; // Fix 3: Explicit array allocation
      read(fd[0], parent_arr, 2 * sizeof(int));
      close(fd[0]); // Close read end after reading
      
      int a = parent_arr[0];
      int b = parent_arr[1];
      
      // Prevent division by zero if both inputs are 0
      if (a == 0 && b == 0) {
         printf("LCM = 0\n");
      } else {
         lcm = (a * b) / findgcd(a, b);
         printf("LCM = %d\n", lcm);
      }
      
      wait(NULL); // Clean up the child process
   }
   return 0;
}

